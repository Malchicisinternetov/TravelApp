# Shared infrastructure for services launched from the IDE/on the host.
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_ENABLED=true
KAFKA_TIMEOUT_SECONDS=30
KAFKA_AUTO_CREATE_TOPICS=true
# Within the Compose network: REDIS_URL=redis://redis:6379 and KAFKA_BOOTSTRAP_SERVERS=kafka:29092
# Production broker authentication (never add these to frontend VITE_* variables):
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_SASL_JAAS_CONFIG=
