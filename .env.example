# Copy to ../.env. Never commit real values or pass this file into Docker builds.
# Start from the project directory: docker compose --env-file ../.env up -d --build
FRONTEND_PORT=8080

# Replace all three secrets with independent random strings (at least 32 bytes).
JWT_SECRET=replace-with-random-jwt-secret-at-least-32-bytes
BOT_SERVICE_SECRET=replace-with-random-bot-secret-at-least-32-bytes
NOTIFICATION_SERVICE_SECRET=replace-with-random-notification-secret-at-least-32-bytes
JWT_ISSUER=travelapp
JWT_TTL_SECONDS=3600
WEB_SESSION_TTL_SECONDS=604800
# false for local HTTP; true when serving the site over HTTPS.
WEB_SESSION_SECURE=false

# Compose supplies internal JDBC URLs. Each service has its own database and user.
POSTGRES_DB=users
POSTGRES_USERNAME=travel_users
POSTGRES_PASSWORD=replace-users-db-password
TRIP_POSTGRES_DB=trips
TRIP_POSTGRES_USERNAME=travel_trips
TRIP_POSTGRES_PASSWORD=replace-trips-db-password
EXPENSES_POSTGRES_DB=expenses
EXPENSES_POSTGRES_USERNAME=travel_expenses
EXPENSES_POSTGRES_PASSWORD=replace-expenses-db-password
NOTIFICATIONS_POSTGRES_DB=notifications
NOTIFICATIONS_POSTGRES_USERNAME=travel_notifications
NOTIFICATIONS_POSTGRES_PASSWORD=replace-notifications-db-password

REDIS_ENABLED=true
KAFKA_ENABLED=true
KAFKA_TIMEOUT_SECONDS=30
KAFKA_AUTO_CREATE_TOPICS=true

# Telegram is optional. Enable both only after supplying a real token.
BOT_ENABLED=false
NOTIFICATIONS_ENABLED=false
TELEGRAM_BOT_NAME=travelapp_bot
TELEGRAM_BOT_TOKEN=
VITE_TELEGRAM_BOT_USERNAME=
NOTIFICATIONS_POLL_INTERVAL_MS=60000
EXPENSES_TIME_ZONE=Europe/Moscow

WEATHER_FORECAST_URL=https://api.open-meteo.com
WEATHER_GEOCODING_URL=https://geocoding-api.open-meteo.com
WEATHER_API_KEY=
CURRENCY_API_URL=https://api.frankfurter.dev
