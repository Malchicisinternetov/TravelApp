<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>com.example</groupId>
    <artifactId>TravelApp</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <properties>
        <excludedTestGroups></excludedTestGroups>
    </properties>
    <name>TravelApp</name>
    <description>TravelApp</description>
    <modules>
        <module>userservice</module>
        <module>tripservice</module>
        <module>expensesservice</module>
        <module>botservice</module>
        <module>notificationservice</module>
        <module>sharedlib</module>
        <module>weatherservice</module>
        <module>currencyservice</module>
    </modules>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludedGroups>${excludedTestGroups}</excludedGroups>
                    <systemPropertyVariables>
                        <travel.kafka.enabled>false</travel.kafka.enabled>
                        <travel.redis.enabled>false</travel.redis.enabled>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>16</source>
                    <target>16</target>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>ci</id>
            <properties>
                <excludedTestGroups>integration</excludedTestGroups>
            </properties>
        </profile>
    </profiles>

</project>
